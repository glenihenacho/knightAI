# --- Core ---------------------------------------------------------------
PORT=4000
# Secret used to sign JWTs. CHANGE THIS in any real deployment.
JWT_SECRET=dev-secret-change-me
# Comma-separated list of allowed web origins for CORS.
CORS_ORIGINS=http://localhost:3000
# Path to the SQLite database file.
DATABASE_PATH=./data/knightstream.db

# --- Demo ---------------------------------------------------------------
# When true, the seed marks demo channels as live and the poller leaves
# them live so the UI shows content without real platform credentials.
DEMO_MODE=true
# How often (ms) the background poller refreshes live status.
POLL_INTERVAL_MS=60000

# --- Provider credentials (all optional) --------------------------------
# Without these, live-status detection degrades gracefully:
#   - Kick works keyless (public endpoint).
#   - Twitch/YouTube fall back to "unknown" unless configured.
#   - Embedded players still work for everyone (public iframes).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=

# --- OAuth (optional, for verified account linking) ---------------------
# Redirect URIs must be registered with each provider.
OAUTH_REDIRECT_BASE=http://localhost:4000/api/connections/oauth
TWITCH_OAUTH_CLIENT_ID=
TWITCH_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KICK_OAUTH_CLIENT_ID=
KICK_OAUTH_CLIENT_SECRET=
